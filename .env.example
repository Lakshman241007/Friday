# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=call-recordings

# Sarvam AI (Translator AI / intent classification)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_CHAT_MODEL=sarvam-105b

# Comma-separated origins allowed to call this API (the frontend dev
# server by default; add your deployed frontend origin in production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
